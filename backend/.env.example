# Backend environment
#
# Copy to backend/.env for local development.

PORT=5001
CORS_ORIGIN=http://localhost:5173

# MongoDB is optional for demo mode. Leave empty to run without MongoDB.
MONGO_URI=

# Local Ganache default.
BLOCKCHAIN_NODE_URL=http://127.0.0.1:8545

# Set this after running:
#   npx truffle migrate --reset --network development
CONTRACT_ADDRESS=

# Local Ganache private key used only for development transactions.
# Never commit real keys.
OWNER_PRIVATE_KEY=
